#!name=红果短剧 去广告
#!desc=MITM 改写红果业务接口响应，删除内嵌广告 item；并拦截穿山甲/埋点域名。依赖 hongguo-adblock.js
#!system=ios
#!author=WorkBuddy

# ============================================================
# 一、域名层拦截
#    仅保留有明确广告/监测属性的域名；业务域名一律不动，
#    避免正文、登录、支付功能被误伤。
# ============================================================
[Rule]

# --- 广告归因与监测（沙盒实测出现频次高，非业务必需）---
DOMAIN-SUFFIX,ma.zijieapi.com,REJECT-DROP
DOMAIN-SUFFIX,mon.zijieapi.com,REJECT-DROP
DOMAIN-SUFFIX,log5-applog-hl.fqnovel.com,REJECT-DROP

# --- 广告素材代理（creativelab = 创意实验室，纯广告素材）---
DOMAIN-SUFFIX,creativelab-proxy.bytedance.com,REJECT-TINYGIF

# --- 穿山甲 / Gromore 广告 SDK（本次沙盒未出现，保留以防开屏走独立 SDK）---
DOMAIN-SUFFIX,pangle.io,REJECT-TINYGIF
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT-TINYGIF
DOMAIN-SUFFIX,gromore.zijieapi.com,REJECT-TINYGIF

# --- 广告落地页（点击广告后的 H5，拦截不影响主流程）---
DOMAIN-SUFFIX,aweme.snssdk.com,REJECT-TINYGIF

# --- 第三方归因 ---
DOMAIN-SUFFIX,admaster.com.cn,REJECT-DROP
DOMAIN-SUFFIX,ad.oceanengine.com,REJECT-TINYGIF

# 注意：i.snssdk.com 承载字节通用业务接口（登录/分享/支付），
# 不要加入 REJECT，否则会连带影响核心功能。

# ============================================================
# 二、MITM 域名
#    *.fqnovel.com 覆盖全部 API 变体（api / api3 / api5-normal-* /
#    p0-reading-private 等），图片 CDN 在 fqnovelpic.com，不受影响。
# ============================================================
[MITM]
hostname = %APPEND% *.fqnovel.com

# ============================================================
# 三、响应改写脚本
#    只处理 fqnovel.com 的 JSON 响应，图片/静态资源不进入脚本。
# ============================================================
[Script]
http-response ^https?://[^/]*\.fqnovel\.com/ script-path=https://raw.githubusercontent.com/GitHubmnxz/ip/refs/heads/main/hongguo-adblock.js, requires-body=true, max-size=5242880, timeout=15, tag=红果-去广告
